# ======================================================
#  Proxmox nodes (the hypervisors themselves). Managed as
#  root: playbooks/proxmox.yml (host prep for k3s LXCs)
#  and the raw lxc.* lines provision.yml writes into
#  /etc/pve. In no environment group, so nothing deploys
#  here.
#
#  proxmox_node on a guest's line must match one of these names
#  (the node name Proxmox shows in its UI), because provision.yml
#  uses it to reach the node over SSH for k3s guests.
# ======================================================

[proxmox_nodes]
pve1           ansible_host=192.168.1.2
pve2           ansible_host=192.168.1.3
pve3           ansible_host=192.168.1.4
