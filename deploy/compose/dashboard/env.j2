# Rendered to the dashboard checkout's .env by roles/git_stack (the path
# is the `path:` of this stack's git_stacks entry). Never commit a
# rendered copy - this template is the only form of it that belongs in
# git.
#
# No Jinja references to `stack` here on purpose: git_stack's
# pre-flight renders this same template from a loop where the entry is
# `item`, not `stack`, so anything reaching for `stack` would fail the
# check that exists to catch a missing vault key.
#
# Two kinds of value here:
#   literal    - inert operational config (cron schedules, timezones,
#                ports, public hostnames). Readable on purpose: these
#                are the knobs worth seeing in a diff.
#   vault ref  - everything else, including several that look inert but
#                aren't. A "URL-as-secret" share link, or a topic name
#                anyone knowing it can publish to, belongs in the vault
#                even though it does not look like a password. When in
#                doubt it went to the vault.
#
# Every vault_* key below must exist in
# inventory/group_vars/production/vault_dashboard.yml - preflight
# renders this template to prove it before any deploy runs.

# --- literal -----------------------------------------------------------
PORT=8080
TZ=Europe/Berlin
LOG_LEVEL=info
CACHE_TTL_MS=15000
DIGEST_ENABLED=true
DIGEST_CRON=0 8 * * *

# --- vault refs --------------------------------------------------------
SECRET_KEY={{ vault_dashboard_secret_key }}
PASSWORD_HASH={{ vault_dashboard_password_hash }}
API_TOKEN={{ vault_dashboard_api_token }}
# URL-as-secret: the share token is the whole credential.
CALENDAR_FEED_URL={{ vault_dashboard_calendar_feed_url }}
# Capability: anyone who knows the topic can publish to it.
NOTIFY_TOPIC={{ vault_dashboard_notify_topic }}
SMTP_PASSWORD={{ vault_dashboard_smtp_password }}
DIGEST_TO={{ vault_dashboard_digest_to }}
