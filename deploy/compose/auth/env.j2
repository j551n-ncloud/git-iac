{# Rendered to /root/auth/.env on the pocketid host.

   The two secrets come from the vault. The rest are plain config, but
   their current values were NOT copied off the host (reading that
   .env was blocked), so they still need filling in from
   /root/auth/.env before the first deploy - otherwise this render
   silently replaces a working .env with wrong values.

   ENCRYPTION_KEY especially: pocket-id encrypts its data with it.
   Changing it breaks the existing install, so copy the current value
   exactly, don't generate a new one. #}
APP_URL={{ pocketid_app_url }}
TRUST_PROXY={{ pocketid_trust_proxy }}
PUID={{ pocketid_puid }}
PGID={{ pocketid_pgid }}
GEOLITE_DB_PATH={{ pocketid_geolite_db_path }}
GEOLITE_DB_URL={{ pocketid_geolite_db_url }}
MAXMIND_LICENSE_KEY={{ vault_pocketid_maxmind_license_key }}
ENCRYPTION_KEY={{ vault_pocketid_encryption_key }}
